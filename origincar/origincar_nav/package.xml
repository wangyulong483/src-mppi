<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>origincar_nav</name>
  <version>0.0.0</version>
  <description>OriginCar SLAM (slam_toolbox) and Nav2 navigation for the hall (task 1). Ackermann + SmacPlannerHybrid + RegulatedPurePursuit, Lslidar N10 for /scan.</description>
  <maintainer email="support@ps-micro.com">GuYueHome</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Nav2 stack -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_constrained_smoother</exec_depend>

  <!-- SLAM -->
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Robot base / bringup / localization / TF -->
  <exec_depend>origincar_bringup</exec_depend>
  <exec_depend>origincar_base</exec_depend>
  <exec_depend>origincar_description</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- LiDAR (Lslidar N10) -->
  <exec_depend>lslidar_driver</exec_depend>

  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
